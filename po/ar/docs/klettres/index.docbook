><action
>اختر</action
> اللغة الإنجليزية.</para
></listitem>
</varlistentry>

<varlistentry>
<term
><menuchoice
><guimenu
>اللغة</guimenu
> <guimenuitem
>الفرنسية</guimenuitem
> </menuchoice
></term>
<listitem
